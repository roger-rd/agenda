# development | test | production (por defecto development). En test no se carga .env.
NODE_ENV=development
# Hostname o IP, sin espacios; por defecto 127.0.0.1.
HOST=127.0.0.1
# Entero decimal entre 1 y 65535; por defecto 3000.
PORT=3000
# fatal | error | warn | info | debug | trace | silent. Por defecto info; en test silent.
LOG_LEVEL=info

# Archivos locales ignorados por Git: nunca se versionan.
# .env: desarrollo, runtime NestJS, DATABASE_NAME=agenda_dev, DATABASE_USER=agenda_dev_app.
# .env.test: pruebas, acceso app, DATABASE_NAME=agenda_test, DATABASE_USER=agenda_test_app.
# En NODE_ENV=test NestJS NO lee archivos .env: inyectar variables ficticias en cada prueba.
# .env.migration: desarrollo, solo migraciones, DATABASE_NAME=agenda_dev, DATABASE_USER=agenda_dev_owner.
# .env.test.migration: pruebas, solo migraciones, DATABASE_NAME=agenda_test, DATABASE_USER=agenda_test_owner.
# Cada archivo usa las mismas variables DATABASE_* siguientes; nunca mezclar accesos.
# DATABASE_MIGRATION_* está prohibido en el entorno de la aplicación.
# Migraciones: desarrollo/test leen únicamente su archivo; producción solo variables de proceso.
# Hostname o IP válido; por defecto 127.0.0.1. Desarrollo/test solo 127.0.0.1, ::1 o localhost.
DATABASE_HOST=127.0.0.1
# Entero decimal 1–65535; por defecto 5433.
DATABASE_PORT=5433
# Nombre y usuario obligatorios: /^[a-z][a-z0-9_]{0,62}$/.
# Desarrollo: base termina _dev, usuario empieza agenda_dev_.
# Test: base termina _test, usuario empieza agenda_test_.
# Producción: base NO termina _dev/_test, usuario NO empieza agenda_dev_/agenda_test_.
# Runtime exige usuario terminado _app; migraciones exigen _owner.
DATABASE_NAME=agenda_dev
DATABASE_USER=agenda_dev_app
# Obligatoria: 16–128 caracteres, sin espacios ni controles. Siempre vacía en la plantilla.
DATABASE_PASSWORD=
# Entero decimal 1–20; por defecto 10, o 5 en test.
DATABASE_POOL_MAX=10
