{
  "name": "agenda-contenido-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": { "node": ">=24.11.0" },
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "typescript": "~6.0.3",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/express": "^5.0.6",
    "eslint": "^9.39.5",
    "@eslint/js": "^9.39.5",
    "typescript-eslint": "^8.72.1",
    "globals": "^17.13.0"
  }
}
